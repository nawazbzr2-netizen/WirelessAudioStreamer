<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#F5F3FF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apna role choose karo"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ek baar select karo. Baad mein Settings se badal sakte ho."
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="32dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAuto"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Auto (Send + Receive)"
        android:textSize="16sp"
        app:backgroundTint="#6A1B9A"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSender"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Sender (sirf bhejo)"
        android:textSize="16sp"
        app:backgroundTint="#E65100"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReceiver"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Receiver (sirf suno)"
        android:textSize="16sp"
        app:backgroundTint="#2E7D32"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Auto = dono phones ek doosre ko awaaz bhej/sunge.\nSender = local mute, awaaz dusre pe.\nReceiver = sirf awaaz suno."
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginTop="16dp" />
</LinearLayout>
