<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0D0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wireless Audio"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dono phones auto connect + background mein chalega"
            android:textSize="13sp"
            android:textColor="#90A4AE"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connection type"
            android:textSize="14sp"
            android:textColor="#B0BEC5"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSameWifi"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Same WiFi"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#1E88E5"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHotspot"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Hotspot"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#00897B"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBluetooth"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Bluetooth"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#5E35B1"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A1A"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Abhi connected nahi"
                android:textSize="15sp"
                android:textColor="#81C784"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvConnectionType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Same WiFi"
                android:textSize="13sp"
                android:textColor="#FFB74D"
                android:gravity="center"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvLatency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Latency: -- ms"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#4FC3F7"
                android:gravity="center"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Connect karo"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#43A047"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDisconnect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Disconnect"
            android:textSize="15sp"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kaise use karein:\n\n1. Dono phones pe app install karo\n2. Same WiFi ya Hotspot pe rakho\n3. DONO phones pe Connect dabao (permission allow)\n4. Auto mil jayenge\n5. Screen off / minimize kar sakte ho — disconnect nahi hoga\n6. Ek pe gana chalao, dusre pe suno"
            android:textSize="13sp"
            android:textColor="#78909C"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>
</ScrollView>
