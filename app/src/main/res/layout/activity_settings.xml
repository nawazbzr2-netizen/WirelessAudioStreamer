<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Default role"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/roleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/rbAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auto (Send + Receive)"
                android:padding="12dp" />

            <RadioButton
                android:id="@+id/rbSender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sender"
                android:padding="12dp" />

            <RadioButton
                android:id="@+id/rbReceiver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Receiver"
                android:padding="12dp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Screen share (optional)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Receiver chahe to sender ki screen dekh sake (sirf view — remote control Android allow nahi karta bina special access)."
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swScreenShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Screen share chahiye"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Save"
            app:backgroundTint="#6A1B9A" />
    </LinearLayout>
</ScrollView>
